# remove.bg API key — get one at https://www.remove.bg/api
# The replace-background endpoint requires this to work.
REMOVE_BG_API_KEY=your-api-key-here

# remove.bg endpoint (override only for testing / self-hosted mirrors)
REMOVE_BG_ENDPOINT=https://api.remove.bg/v1.0/removebg

# Official 大乐透 draw-history API (used by /lottery/verify-ticket and
# /lottery/winning/:issue when winning numbers are not supplied explicitly)
LOTTERY_WINNING_ENDPOINT=https://webapi.sporttery.cn/gateway/lottery/getHistoryPageListV1.qry

# --- Authentication (JWT + user accounts) ---
# HMAC signing key. MUST be set in production; when empty a random key is
# generated at startup so tokens do not survive restarts.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (Go duration, default 24h)
JWT_TTL=24h
# Issuer claim (default wechatapp-web)
JWT_ISSUER=wechatapp-web

# Name shown next to the account in authenticator apps (TOTP / MFA)
MFA_ISSUER=wechatapp-web

# --- Email delivery (used by the MFA email reset flow) ---
# console: prints the email (with the code) to the server log — no SMTP needed.
#         Good for development; do NOT use in production.
# smtp:   deliver through the SMTP server configured below.
EMAIL_MODE=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com

# Optional JSON file to persist accounts across restarts (empty = memory only).
# Relative paths are resolved from the working directory.
# Only used when DB_HOST is NOT set.
USERS_FILE=data/users.json

# --- MySQL user store (preferred) ---
# Set DB_HOST to store accounts in MySQL instead of memory/JSON.
# The database and users table are created automatically on startup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD="Root@123456"
DB_NAME=wechatapp-web
DB_CHARSET=utf8mb4

# Initial admin account, seeded at startup (idempotent).
# Change ADMIN_PASSWORD before deploying!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# HTTP listen address
LISTEN_ADDR=:8080
